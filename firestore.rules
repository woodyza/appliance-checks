rules_version = '2';

service cloud.firestore {
  function pad2(n) {
    return n < 10 ? '0' + string(n) : string(n);
  }

  function dateString(t) {
    return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
  }

  function firstOfPreviousMonth() {
    let t = request.time;
    let year = t.month() == 1 ? t.year() - 1 : t.year();
    let month = t.month() == 1 ? 12 : t.month() - 1;
    return string(year) + '-' + pad2(month) + '-01';
  }

  function isSuperadmin() {
    return request.auth != null && request.auth.uid == 'emulator-superadmin';
  }

  function adminEmail() {
    return request.auth.token.get('email', null).lower();
  }

  function hasVerifiedEmail() {
    return request.auth != null
      && request.auth.token.get('email', null) != null
      && request.auth.token.get('email_verified', false) == true;
  }

  // `before` is the responses map prior to this write: {} on create, resource.data.responses on update.
  function validCheckWrite(checkId, before) {
    let data = request.resource.data;
    let newKeys = data.responses.keys().removeAll(before.keys());
    let newValues = data.responses.values().removeAll(before.values());
    return data.keys().hasAll(['applianceId', 'scheduledDate', 'monthly', 'checkSheetVersion', 'responses', 'updatedAt'])
      && data.keys().hasOnly(['applianceId', 'scheduledDate', 'monthly', 'checkSheetVersion', 'responses', 'updatedAt'])
      && data.applianceId is string
      && data.monthly is bool
      && data.responses is map
      && data.responses.size() <= 500
      && checkId == data.applianceId + '_' + data.scheduledDate
      && data.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.scheduledDate >= firstOfPreviousMonth()
      // A Check opens EARLY_DAYS (2) NZ days early; +3 UTC days always covers that.
      && data.scheduledDate <= dateString(request.time + duration.value(3, 'd'))
      && data.checkSheetVersion is int
      && data.checkSheetVersion >= 1
      && data.responses.diff(before).affectedKeys().size() <= 1
      && (newKeys.size() == 0 || newKeys[0].matches('^[2-9a-hjkmnp-z]{8}$'))
      && (newValues.size() == 0 || (newValues[0] is string && newValues[0].size() >= 1 && newValues[0].size() <= 200))
      && data.updatedAt == request.time;
  }

  match /databases/{database}/documents {
    // These read documents, so they live inside this match, where `database` is bound.
    function isAdmin() {
      return hasVerifiedEmail() && exists(/databases/$(database)/documents/adminUsers/$(adminEmail()));
    }

    function adminBrigadeIds() {
      return get(/databases/$(database)/documents/adminUsers/$(adminEmail())).data.brigadeIds;
    }

    function isBrigadeAdmin(slug) {
      return isSuperadmin() || (isAdmin()
        && get(/databases/$(database)/documents/brigades/$(slug)).data.brigadeId in adminBrigadeIds());
    }

    // Where and whether a brigade's weekly email goes is for its VSOs and the superadmin, not
    // its Brigade Admin: the one place the rules read `role`, which only the superadmin writes.
    function isBrigadeVso(slug) {
      return isSuperadmin() || (isBrigadeAdmin(slug)
        && get(/databases/$(database)/documents/adminUsers/$(adminEmail())).data.role == 'vso');
    }

    function applianceDocPath(slug, applianceId) {
      return /databases/$(database)/documents/brigades/$(slug)/appliances/$(applianceId);
    }

    function validApplianceFields(data) {
      return data.keys().hasOnly(['callsign', 'active', 'currentCheckSheetVersion'])
        && data.keys().hasAll(['callsign', 'active', 'currentCheckSheetVersion'])
        && data.callsign is string
        && data.callsign.size() >= 1
        && data.callsign.size() <= 60
        && data.active is bool;
    }

    function validPointerMove(slug, applianceId) {
      let before = resource.data.currentCheckSheetVersion;
      let after = request.resource.data.currentCheckSheetVersion;
      return after == before
        || (after is int
          && after == (before == null ? 1 : before + 1)
          && existsAfter(/databases/$(database)/documents/brigades/$(slug)/appliances/$(applianceId)/checkSheetVersions/$(string(after))));
    }

    function validBrigadeFields(data) {
      return data.keys().hasOnly(['brigadeId', 'name', 'checkDay', 'active'])
        && data.keys().hasAll(['brigadeId', 'name', 'checkDay', 'active'])
        && data.brigadeId is string
        && data.brigadeId.size() >= 1
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.checkDay is int
        && data.checkDay >= 1
        && data.checkDay <= 7
        && data.active is bool;
    }

    match /brigades/{slug} {
      allow get: if true;
      allow list: if isSuperadmin() || (isAdmin() && resource.data.brigadeId in adminBrigadeIds());

      allow create: if isSuperadmin()
        && slug.matches('^[2-9a-hjkmnp-z]{6}$')
        && validBrigadeFields(request.resource.data)
        && request.resource.data.active == true;

      // Only the superadmin deactivates a brigade, and nobody deletes one: its Checks would be orphaned.
      allow update: if isBrigadeAdmin(slug)
        && validBrigadeFields(request.resource.data)
        && request.resource.data.brigadeId == resource.data.brigadeId
        && (request.resource.data.active == resource.data.active || isSuperadmin());

      allow delete: if false;

      match /private/settings {
        allow read: if isBrigadeVso(slug);
        allow create, update: if isBrigadeVso(slug)
          && request.resource.data.keys().hasOnly(['reportEmail', 'weeklyEmail'])
          && (!('reportEmail' in request.resource.data)
            || (request.resource.data.reportEmail is string && request.resource.data.reportEmail.size() <= 254))
          && (!('weeklyEmail' in request.resource.data) || request.resource.data.weeklyEmail is bool);
        allow delete: if false;
      }

      // Unlike the settings, any admin of the brigade sets this. `private/monthlyReportSent` has no
      // rule, so only the function reads or writes it.
      match /private/monthlyReport {
        allow read: if isBrigadeAdmin(slug);
        allow create, update: if isBrigadeAdmin(slug)
          && request.resource.data.keys().hasOnly(['enabled', 'email'])
          && request.resource.data.enabled is bool
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && (!request.resource.data.enabled || request.resource.data.email.size() > 0);
        allow delete: if false;
      }

      match /appliances/{applianceId} {
        allow get, list: if true;

        allow create: if isBrigadeAdmin(slug)
          && validApplianceFields(request.resource.data)
          && request.resource.data.active == true
          && request.resource.data.currentCheckSheetVersion == null
          && applianceId.matches('^[A-Za-z0-9_-]{1,32}$')
          && applianceId != 'admin';

        allow update: if isBrigadeAdmin(slug)
          && validApplianceFields(request.resource.data)
          && validPointerMove(slug, applianceId);

        allow delete: if false;

        match /checkSheetVersions/{version} {
          allow get, list: if true;

          allow create: if isBrigadeAdmin(slug)
            && request.resource.data.keys().hasOnly(['version', 'createdAt', 'origin', 'sections'])
            && request.resource.data.keys().hasAll(['version', 'createdAt', 'origin', 'sections'])
            && request.resource.data.version is int
            && version == string(request.resource.data.version)
            && getAfter(applianceDocPath(slug, applianceId)).data.currentCheckSheetVersion == request.resource.data.version
            && request.resource.data.createdAt == request.time
            && request.resource.data.origin is map
            && request.resource.data.origin.type in ['editor', 'import']
            && request.resource.data.sections is list;

          allow update, delete: if false;
        }

        match /private/checkSheetDraft {
          allow read, delete: if isBrigadeAdmin(slug);
          allow create, update: if isBrigadeAdmin(slug)
            && request.resource.data.keys().hasOnly(['baseVersion', 'origin', 'sections'])
            && request.resource.data.keys().hasAll(['baseVersion', 'origin', 'sections']);
        }
      }

      match /checks/{checkId} {
        allow get: if true;
        allow list: if isSuperadmin() || resource.data.scheduledDate >= firstOfPreviousMonth() || isBrigadeAdmin(slug);
        allow delete: if false;

        allow create: if validCheckWrite(checkId, {})
          && request.resource.data.checkSheetVersion
            <= get(/databases/$(database)/documents/brigades/$(slug)/appliances/$(request.resource.data.applianceId)).data.currentCheckSheetVersion;

        allow update: if validCheckWrite(checkId, resource.data.responses)
          && request.resource.data.monthly == resource.data.monthly
          && request.resource.data.checkSheetVersion >= resource.data.checkSheetVersion
          && (request.resource.data.checkSheetVersion == resource.data.checkSheetVersion
            || request.resource.data.checkSheetVersion
              <= get(/databases/$(database)/documents/brigades/$(slug)/appliances/$(request.resource.data.applianceId)).data.currentCheckSheetVersion);
      }
    }

    match /adminUsers/{email} {
      allow get: if isSuperadmin() || (hasVerifiedEmail() && email == adminEmail());
      allow list: if isSuperadmin();
      allow create, update: if isSuperadmin() && email == email.lower() && request.resource.data.email == email;
      allow delete: if isSuperadmin();
    }
  }
}
