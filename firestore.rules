rules_version = '2';

service cloud.firestore {
  function pad2(n) {
    return n < 10 ? '0' + string(n) : string(n);
  }

  function dateString(t) {
    return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
  }

  function firstOfPreviousMonth() {
    let t = request.time;
    let year = t.month() == 1 ? t.year() - 1 : t.year();
    let month = t.month() == 1 ? 12 : t.month() - 1;
    return string(year) + '-' + pad2(month) + '-01';
  }

  // `before` is the responses map prior to this write: {} on create, resource.data.responses on update.
  function validCheckWrite(checkId, before) {
    let data = request.resource.data;
    let newKeys = data.responses.keys().removeAll(before.keys());
    let newValues = data.responses.values().removeAll(before.values());
    return data.keys().hasAll(['applianceId', 'scheduledDate', 'monthly', 'checkSheetVersion', 'responses', 'updatedAt'])
      && data.keys().hasOnly(['applianceId', 'scheduledDate', 'monthly', 'checkSheetVersion', 'responses', 'updatedAt'])
      && data.applianceId is string
      && data.monthly is bool
      && data.responses is map
      && data.responses.size() <= 500
      && checkId == data.applianceId + '_' + data.scheduledDate
      && data.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.scheduledDate >= firstOfPreviousMonth()
      && data.scheduledDate <= dateString(request.time + duration.value(1, 'd'))
      && data.checkSheetVersion is int
      && data.checkSheetVersion >= 1
      && data.responses.diff(before).affectedKeys().size() <= 1
      && (newKeys.size() == 0 || newKeys[0].matches('^[2-9a-hjkmnp-z]{8}$'))
      && (newValues.size() == 0 || (newValues[0] is string && newValues[0].size() >= 1 && newValues[0].size() <= 200))
      && data.updatedAt == request.time;
  }

  match /databases/{database}/documents {
    match /brigades/{slug} {
      allow get: if true;
      allow write: if false;

      match /private/settings {
        allow read, write: if false;
      }

      match /appliances/{applianceId} {
        allow get, list: if true;
        allow write: if false;

        match /checkSheetVersions/{version} {
          allow get, list: if true;
          allow write: if false;
        }
      }

      match /checks/{checkId} {
        allow get: if true;
        allow list: if resource.data.scheduledDate >= firstOfPreviousMonth();
        allow delete: if false;

        allow create: if validCheckWrite(checkId, {})
          && request.resource.data.checkSheetVersion
            <= get(/databases/$(database)/documents/brigades/$(slug)/appliances/$(request.resource.data.applianceId)).data.currentCheckSheetVersion;

        allow update: if validCheckWrite(checkId, resource.data.responses)
          && request.resource.data.monthly == resource.data.monthly
          && request.resource.data.checkSheetVersion >= resource.data.checkSheetVersion
          && (request.resource.data.checkSheetVersion == resource.data.checkSheetVersion
            || request.resource.data.checkSheetVersion
              <= get(/databases/$(database)/documents/brigades/$(slug)/appliances/$(request.resource.data.applianceId)).data.currentCheckSheetVersion);
      }
    }
  }
}
